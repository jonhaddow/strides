{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "strides",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Only served on strides.app.haddow.me (sign-in sends people back there).
	"workers_dev": false,
	"routes": [{ "pattern": "strides.app.haddow.me", "custom_domain": true }],
	// Keeps request logs and console output (Workers Logs, free tier) for debugging.
	"observability": {
		"enabled": true
	},
	"vars": {
		// Public OAuth client ID; the secret is a Worker secret (GOOGLE_CLIENT_SECRET).
		"GOOGLE_CLIENT_ID": "856408914710-dgcs4pkdkahr6jchr0pefodiobhjrmv4.apps.googleusercontent.com"
	},
	// Off: branch previews would share the live D1 database.
	"preview_urls": false,
	"d1_databases": [
		{
			// Created with --jurisdiction eu, so the data stays in the EU.
			"binding": "DB",
			"database_name": "strides",
			"database_id": "e1753787-df46-4551-a6d6-48809f0265e7",
			"migrations_dir": "drizzle"
		}
	]
}
